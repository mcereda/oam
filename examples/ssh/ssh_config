################################################################################
## ~/.ssh/config
##
## Gotchas:
## - once a Host or Match block starts, it gobbles options until the next block *regardless* of indentation
## - blocks can specify multiple host names (and aliases)
## - targets may match multiple blocks; in that case, options are applied as the blocks are discovered
## - options are applied first-come-first-served, so:
##   - specific and higher priority settings must go on top, generic and lower priority ones must go at the bottom
##   - specify global options *before* any block to apply them to all targets
##   - set defaults at the *end* of the file inside a match-all "Host *" block so that they are applied as fallbacks
## - host specificity is NOT a substitute for priority
## - host blocks apply the settings they defined *only* to the hostnames that matched
## - canonicalization forces the client to parse the configuration again, in order to apply settings to the now
##   canonicalized hostname
##
## Sources:
## - https://man.openbsd.org/ssh_config
################################################################################

## Settings to apply to all targets

# Keep connections open for some time to reuse them
# %C returns a hash of different information and is useful as socket identifier
ControlMaster   auto
ControlPersist  30s
ControlPath     ~/.ssh/control-%C

# GnuPG integration
IdentityAgent  ~/.gnupg/S.gpg-agent.ssh

## Settings for specific targets

# Canonicalize hostnames as the first thing
Host  net?a?-fw? org?-h?-sw?
	CanonicalDomains     that.org
	CanonicalizeMaxDots  0
Host *
  CanonicalizeHostname  yes
  CanonicalDomains      lan localdomain my.org

# 'special' devices
# E.g. work ones
Host  !bastion* *.brt*.my.org *.brs? *.brs??
	AddressFamily  inet6
	ProxyCommand   ssh -W %h:%p `host bastion.my.org | awk '/address/ {print $4; exit}' | xargs host | cut -d\  -f5`

# Connect to secured hosts
# E.g. targets using non-default configuration
Host  *-bastion-* *-fw
	IdentitiesOnly  yes
	IdentityFile    ~/.ssh/id_rsa
	Port            2222

# Avoid OS incompatibility nuisances
# E.g. LANG not set when connecting to Linux from Darwin
Host  linux-* raspberrypi?
	SendEnv  -LC_* PAGER
	SetEnv   LANG=C LANGUAGE=en LC_ALL=C

# Connect to unresolvable host names
# E.g. home routers
Host  router fixed-ip
	HostName  192.168.50.1
	User      root

# Enable connections to old SSH server versions
# E.g. legacy targets using old key algorithms
Host  legacy-hosts azure-vm-* oci-bastion-*
	HostKeyAlgorithms         +ssh-dss +ssh-rsa
	PubkeyAcceptedAlgorithms  +ssh-rsa

# Avoid nuisances with ephemeral hosts and localhost
# E.g. preemptible or testing virtual machines which are often recreated
Host  localhost *-vm-* *.compute.internal
	StrictHostKeyChecking  no
	UserKnownHostsFile     /dev/null

# User-specific settings
# E.g. programmatic accesses
Match  Host *.compute.internal  User ansible
	IdentitiesOnly  yes
	IdentityFile    ~/.ssh/ansible.key
Match  User robots
	AddKeysToAgent       no
	BatchMode            yes
	ForwardAgent         no
	IdentitiesOnly       yes
	IdentityFile         ~/.ssh/robots.id_ed25519
	ServerAliveCountMax  1
	ServerAliveInterval  30
	UseKeyChain          no

## Defaults
## Must be treatead as fallbacks

Host  *
  AddKeysToAgent       yes
  Compression          yes
  ForwardAgent         yes
  HashKnownHosts       no
  ServerAliveCountMax  2
  ServerAliveInterval  300
  UseKeyChain          yes
