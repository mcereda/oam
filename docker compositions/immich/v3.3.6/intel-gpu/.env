# Supported env variables at https://docs.immich.app/install/environment-variables

# The Immich version to use
# Pin this to a specific version using a semver string like "v2.1.0"
IMMICH_VERSION=v3.3.6


# The location where DB files are stored
# Network shares are NOT supported for the database
DB_DATA_LOCATION=./postgres

# Connection parameters for the DB
DB_DATABASE_NAME=immich
DB_USERNAME=postgres
DB_PASSWORD_FILE=/run/secrets/db-password


# Set a timezone and change Etc/UTC to a TZ identifier from this list:
# https://en.wikipedia.org/wiki/List_of_tz_database_time_zones#List
# TZ=Etc/UTC


# The location where uploaded files are stored
UPLOAD_LOCATION=./library
